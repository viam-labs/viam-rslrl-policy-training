{
  "modules": [
    {
      "type": "local",
      "name": "mujoco-sim",
      "executable_path": "/Users/nick.hehr/src/viam-mujoco-sim-floating/run.sh"
    },
    {
      "type": "registry",
      "name": "viam_onnx-cpu",
      "module_id": "viam:onnx-cpu",
      "version": "0.2.2"
    },
    {
      "type": "local",
      "name": "duck-policy",
      "executable_path": "/Users/nick.hehr/src/viam-rslrl-policy-training/duck_policy/run.sh"
    }
  ],
  "packages": [
    {
      "name": "duck-sim",
      "package": "16518049-9dd3-479f-9644-c5d112aa42d8/duck-sim",
      "type": "archive",
      "version": "0.2.0"
    },
    {
      "name": "microduck-walk",
      "package": "16518049-9dd3-479f-9644-c5d112aa42d8/microduck-walk",
      "type": "ml_model",
      "version": "0.1.0"
    },
    {
      "name": "microduck-velocity",
      "package": "16518049-9dd3-479f-9644-c5d112aa42d8/microduck-velocity",
      "type": "ml_model",
      "version": "0.1.0"
    }
  ],
  "components": [
    {
      "name": "sim-world",
      "api": "rdk:component:generic",
      "model": "viam-labs:mujoco-sim:world",
      "attributes": {
        "physics_dt": 0.005
      }
    },
    {
      "name": "duck",
      "api": "rdk:component:generic",
      "model": "viam-labs:mujoco-sim:robot",
      "frame": {
        "parent": "world",
        "translation": {
          "x": 0,
          "y": 0,
          "z": 5
        }
      },
      "attributes": {
        "world": "sim-world",
        "mjcf": "${packages.archive.duck-sim}/duck.xml",
        "actuators": {
          "model": "bam"
        }
      }
    },
    {
      "name": "left-leg",
      "api": "rdk:component:arm",
      "model": "viam-labs:mujoco-sim:arm",
      "frame": {
        "parent": "duck"
      },
      "attributes": {
        "world": "sim-world",
        "robot": "duck",
        "joints": [
          "left_hip_yaw",
          "left_hip_roll",
          "left_hip_pitch",
          "left_knee",
          "left_ankle"
        ],
        "flange_site": "left_foot",
        "home_keyframe": "STAND"
      }
    },
    {
      "name": "head",
      "api": "rdk:component:arm",
      "model": "viam-labs:mujoco-sim:arm",
      "frame": {
        "parent": "duck"
      },
      "attributes": {
        "world": "sim-world",
        "robot": "duck",
        "joints": [
          "neck_pitch",
          "head_pitch",
          "head_yaw",
          "head_roll"
        ],
        "flange_site": "head_camera",
        "home_keyframe": "STAND"
      }
    },
    {
      "name": "right-leg",
      "api": "rdk:component:arm",
      "model": "viam-labs:mujoco-sim:arm",
      "frame": {
        "parent": "duck"
      },
      "attributes": {
        "world": "sim-world",
        "robot": "duck",
        "joints": [
          "right_hip_yaw",
          "right_hip_roll",
          "right_hip_pitch",
          "right_knee",
          "right_ankle"
        ],
        "flange_site": "right_foot",
        "home_keyframe": "STAND"
      }
    },
    {
      "name": "overview",
      "api": "rdk:component:camera",
      "model": "viam-labs:mujoco-sim:camera",
      "attributes": {
        "world": "sim-world",
        "position": [
          0.45,
          0.35,
          0.3
        ],
        "target": [
          0,
          0,
          0.08
        ],
        "width": 1280,
        "height": 720
      }
    },
    {
      "name": "head-cam",
      "api": "rdk:component:camera",
      "model": "viam-labs:mujoco-sim:camera",
      "frame": {
        "parent": "head",
        "orientation": {
          "type": "quaternion",
          "value": {
            "W": -0.5,
            "X": 0.5,
            "Y": -0.5,
            "Z": 0.5
          }
        }
      },
      "attributes": {
        "world": "sim-world",
        "width": 640,
        "height": 480,
        "near_m": 0.005
      }
    },
    {
      "name": "WebGamepad",
      "api": "rdk:component:input_controller",
      "model": "webgamepad",
      "attributes": {}
    }
  ],
  "services": [
    {
      "name": "walk-model",
      "api": "rdk:service:mlmodel",
      "model": "viam:mlmodel:onnx-cpu",
      "attributes": {
        "model_path": "${packages.ml_model.microduck-velocity}/policy.onnx"
      }
    },
    {
      "name": "walker",
      "api": "rdk:service:generic",
      "model": "devrel:duck-policy:controller",
      "attributes": {
        "duck": "duck",
        "mlmodel": "walk-model",
        "world": "sim-world",
        "package_dir": "${packages.ml_model.microduck-velocity}"
      }
    },
    {
      "name": "teleop",
      "api": "rdk:service:generic",
      "model": "devrel:duck-policy:teleop",
      "attributes": {
        "input_controller": "WebGamepad",
        "policy": "walker"
      }
    }
  ]
}
